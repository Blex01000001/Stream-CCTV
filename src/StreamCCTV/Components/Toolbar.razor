@implements IAsyncDisposable
@inject WallState State
@inject StorageService Storage
@inject IJSRuntime JS
@inject Loc L

<div class="toolbar">
    <textarea @ref="_input" rows="1" class="add-input"
              placeholder="@L["tb.placeholder"]"></textarea>
    <button class="btn primary" @onclick="AddAsync">@L["tb.add"]</button>

    @foreach (var (id, n, c, r) in Quick)
    {
        <button class="btn lay @(State.Layout.Id == id ? "on" : "")" title="@L.F("tb.split", n, $"{c}×{r}")" @onclick="() => State.SetLayout(id)">
            <span class="lay-ico" style="grid-template-columns:repeat(@c,1fr);grid-template-rows:repeat(@r,1fr)">
                @for (var i = 0; i < c * r; i++) { <i></i> }
            </span>@n
        </button>
    }

    <select class="sel" title="@L["tb.layout"]" @onchange="OnLayout">
        @foreach (var l in Layouts.All)
        {
            <option value="@l.Id" selected="@(State.Layout.Id == l.Id)">@L.LayoutName(l)</option>
        }
    </select>

    <select class="sel" title="@L["tb.members"]" @onchange="OnMember">
        <option value="">@L["tb.members"]</option>
        @foreach (var m in State.Members)
        {
            <option value="@m.Name" selected="@(_member == m.Name)">@m.Name (@m.Entries.Count)</option>
        }
    </select>
    <button class="btn" disabled="@(string.IsNullOrEmpty(_member))" @onclick="LoadMember">@L["tb.load"]</button>

    <button class="btn" @onclick="ShareAsync">@L["tb.share"]</button>

    <label class="vol" title="@L["tb.volume"]">
        🔊 <input type="range" min="0" max="100" value="@State.Settings.Volume" @oninput="OnVolume" />
    </label>
    <button class="btn" title="@L["tb.muteall.tip"]" @onclick="State.MuteAllAsync">🔇 @L["tb.muteall"]</button>

    <span class="spacer"></span>
    <button class="btn @(State.GlobalControl ? "on" : "")" title="@L["tb.control"]" @onclick="State.ToggleGlobalControl">🎛</button>
    <button class="btn @(State.HideTitles ? "" : "on")" title="@L["tb.titles.tip"]" @onclick="State.ToggleTitles">@L["tb.titles"]</button>
    <button class="btn" title="@L["tb.hide.tip"]" @onclick="State.ToggleToolbar">@L["tb.hide"]</button>
    <button class="btn" title="@L["tb.fullscreen"]" @onclick="FullscreenAsync">⛶</button>
    <button class="btn" title="@L["tb.settings"]" @onclick="OnOpenSettings">⚙</button>
    <button class="btn" title="@L["tb.help"]" @onclick="OnOpenHelp">?</button>
    <span class="sep"></span>
    <button class="btn lang" title="@L["tb.lang"]" @onclick="L.Toggle">🌐 @(L.IsZh ? "中文" : "EN")</button>
</div>

@code {
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    [Parameter] public EventCallback OnOpenHelp { get; set; }

    ElementReference _input;
    IJSObjectReference? _kb;
    DotNetObjectReference<Toolbar>? _self;
    string _member = "";
    static readonly (string Id, int N, int C, int R)[] Quick = { ("2x2", 4, 2, 2), ("3x2", 6, 3, 2), ("3x3", 9, 3, 3) };

    protected override void OnInitialized()
    {
        State.OnChange += Refresh;
        State.OnFocusInput += FocusInput;
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    async void FocusInput()
    {
        if (State.HideToolbar) State.ToggleToolbar();
        try { await Task.Delay(30); if (_kb is not null) await _kb.InvokeVoidAsync("focus", _input); } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _kb = await JS.InvokeAsync<IJSObjectReference>("import", "./js/keyboard.js");
        _self = DotNetObjectReference.Create(this);
        await _kb.InvokeVoidAsync("bindSubmit", _input, _self);
    }

    void OnLayout(ChangeEventArgs e) => State.SetLayout(e.Value?.ToString() ?? "2x2");
    void OnMember(ChangeEventArgs e) => _member = e.Value?.ToString() ?? "";
    Task OnVolume(ChangeEventArgs e) => State.SetVolumeAsync(int.TryParse(e.Value?.ToString(), out var v) ? v : 60);

    [JSInvokable] public Task Submit() => AddAsync();

    async Task AddAsync()
    {
        if (_kb is null) return;
        var text = await _kb.InvokeAsync<string>("takeValue", _input);
        if (string.IsNullOrWhiteSpace(text)) return;
        var failed = State.AddFromText(text);
        if (failed.Count > 0) await _kb.InvokeVoidAsync("setValue", _input, string.Join('\n', failed));
    }

    void LoadMember()
    {
        var list = State.Members.FirstOrDefault(m => m.Name == _member);
        if (list is not null) State.LoadMemberList(list);
    }

    async Task ShareAsync()
    {
        var url = State.BuildShareUrl();
        var ok = await Storage.CopyToClipboardAsync(url);
        State.ShowNotice(ok ? L["tb.copied"] : L.F("tb.copyfail", url));
    }

    async Task FullscreenAsync()
    {
        if (_kb is not null) await _kb.InvokeVoidAsync("toggleFullscreen");
    }

    public async ValueTask DisposeAsync()
    {
        State.OnChange -= Refresh;
        State.OnFocusInput -= FocusInput;
        try { if (_kb is not null) await _kb.DisposeAsync(); } catch { }
        _self?.Dispose();
    }
}
