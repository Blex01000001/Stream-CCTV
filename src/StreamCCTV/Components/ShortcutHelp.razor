@inject Loc L
<div class="modal-back" @onclick="OnClose">
    <div class="modal" @onclick:stopPropagation="true">
        <h2>@L["help.title"] <button class="btn" @onclick="OnClose">✕</button></h2>
        <table class="keys">
            <tr><td><kbd>1</kbd>–<kbd>9</kbd></td><td>@L["help.digits"]</td></tr>
            <tr><td><kbd>M</kbd></td><td>@L["help.m"]</td></tr>
            <tr><td><kbd>C</kbd></td><td>@L["help.c"]</td></tr>
            <tr><td><kbd>F</kbd></td><td>@L["help.f"]</td></tr>
            <tr><td><kbd>H</kbd></td><td>@L["help.h"]</td></tr>
            <tr><td><kbd>Esc</kbd></td><td>@L["help.esc"]</td></tr>
            <tr><td><kbd>?</kbd></td><td>@L["help.q"]</td></tr>
            <tr><td>@L["help.click"]</td><td>@L["help.click.d"]</td></tr>
            <tr><td>@L["help.dbl"]</td><td>@L["help.dbl.d"]</td></tr>
            <tr><td>@L["help.drag"]</td><td>@L["help.drag.d"]</td></tr>
        </table>
        <p class="hint">@L["help.note"]</p>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
}
