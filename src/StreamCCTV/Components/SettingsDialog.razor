@inject WallState State
@inject IHolodexService Holodex
@inject Loc L

<div class="modal-back" @onclick="OnClose">
    <div class="modal wide" @onclick:stopPropagation="true">
        <h2>@L["set.title"] <button class="btn" @onclick="OnClose">✕</button></h2>

        <h3>Holodex</h3>
        <div class="form">
            <label>API Key
                <input type="password" autocomplete="off" @bind="_key" @bind:event="oninput" placeholder="@L["set.key.ph"]" />
            </label>
            <label>@L["set.org"]
                <input @bind="_org" @bind:event="oninput" />
            </label>
            <label>@L["set.keyword"]
                <input @bind="_keyword" @bind:event="oninput" placeholder="@L["set.keyword.ph"]" />
            </label>
            <div class="row">
                <button class="btn primary" @onclick="SaveSettings">@L["set.save"]</button>
                <button class="btn" disabled="@(string.IsNullOrWhiteSpace(_key) || _probing)" @onclick="ProbeAsync">@L["set.probe"]</button>
            </div>
            @if (_probe is not null)
            {
                <pre class="probe">@_probe</pre>
            }
        </div>

        <h3>@L["mem.title"]</h3>
        <div class="form">
            <div class="row">
                <select class="sel" @onchange="OnPick">
                    <option value="">@L["mem.new"]</option>
                    @foreach (var m in _members)
                    {
                        <option value="@m.Name" selected="@(_editing == m.Name)">@m.Name</option>
                    }
                </select>
                @if (_editing is not null)
                {
                    <button class="btn danger" @onclick="DeleteMember">@L["mem.delete"]</button>
                }
            </div>
            <label>@L["mem.name"] <input @bind="_mName" @bind:event="oninput" /></label>
            <label>@L["mem.entries"]
                <textarea rows="6" @bind="_mEntries" @bind:event="oninput"></textarea>
            </label>
            <div class="row"><button class="btn primary" @onclick="SaveMember">@(_editing is null ? L["mem.create"] : L["mem.update"])</button></div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    string _key = "", _org = "", _keyword = "";
    string? _probe;
    bool _probing;
    List<MemberList> _members = new();
    string? _editing;
    string _mName = "", _mEntries = "";

    protected override void OnInitialized()
    {
        var s = State.Settings;
        (_key, _org, _keyword) = (s.HolodexApiKey, s.Org, s.FilterKeyword);
        _members = State.Members.Select(m => new MemberList { Name = m.Name, Entries = new(m.Entries) }).ToList();
    }

    void SaveSettings()
    {
        State.UpdateSettings(new AppSettings
        {
            HolodexApiKey = _key.Trim(),
            Org = string.IsNullOrWhiteSpace(_org) ? "Hololive" : _org.Trim(),
            FilterKeyword = _keyword.Trim(),
            Volume = State.Settings.Volume
        });
        State.ShowNotice(L["set.saved"]);
    }

    async Task ProbeAsync()
    {
        _probing = true; _probe = L["set.loading"];
        try
        {
            var raw = await Holodex.GetLiveRawAsync(_key.Trim(), string.IsNullOrWhiteSpace(_org) ? "Hololive" : _org.Trim());
            Console.WriteLine(raw);   // 完整內容也輸出到瀏覽器 console
            _probe = raw.Length > 6000 ? raw[..6000] + "\n" + L["set.truncated"] : raw;
        }
        catch (Exception e) { _probe = L.F("set.failed", e.Message); }
        _probing = false;
    }

    void OnPick(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        var m = _members.FirstOrDefault(x => x.Name == name);
        _editing = m?.Name;
        _mName = m?.Name ?? "";
        _mEntries = m is null ? "" : string.Join('\n', m.Entries);
    }

    void SaveMember()
    {
        var name = _mName.Trim();
        if (name.Length == 0) { State.ShowNotice(L["mem.needname"]); return; }
        var entries = UrlParser.SplitInput(_mEntries).ToList();
        var existing = _members.FirstOrDefault(m => m.Name == _editing);
        if (existing is not null) { existing.Name = name; existing.Entries = entries; }
        else if (_members.Any(m => m.Name == name)) { State.ShowNotice(L["mem.dupe"]); return; }
        else _members.Add(new MemberList { Name = name, Entries = entries });
        _editing = name;
        State.SaveMembers(_members.Select(m => new MemberList { Name = m.Name, Entries = new(m.Entries) }).ToList());
    }

    void DeleteMember()
    {
        _members.RemoveAll(m => m.Name == _editing);
        _editing = null; _mName = _mEntries = "";
        State.SaveMembers(_members.Select(m => new MemberList { Name = m.Name, Entries = new(m.Entries) }).ToList());
    }
}
