@implements IAsyncDisposable
@inject WallState State
@inject PlayerService Player
@inject Loc L

@* 播放器容器 .player-host 內不放任何 Razor 內容，iframe 由 player.js 建立。 *@
<div class="tile @(IsAudio ? "audio" : "") @(Zoomed ? "zoomed" : "") @(Dim ? "dim" : "")"
     style="@Style" data-tile-id="@Tile.Id" data-name="@Tile.DisplayName">
    <TileTitleBar Tile="Tile" IsAudio="IsAudio" ControlMode="Control"
                  OnAudio="() => State.ToggleAudioAsync(Tile.Id)"
                  OnControl="() => State.ToggleControl(Tile.Id)"
                  OnReload="() => State.ReloadAsync(Tile.Id)"
                  OnRemove="() => State.RemoveTileAsync(Tile.Id)"
                  OnZoom="() => State.ToggleZoom(Tile.Id)" />
    <div class="tile-body">
        <div class="player-box"><div class="player-host" @ref="_host"></div></div>
        <div class="tile-overlay @(Control ? "off" : "")" data-hint="@L["tile.hint"]" @onclick="() => State.ToggleAudioAsync(Tile.Id)"></div>
        @if (Tile.Status is TileStatus.Error or TileStatus.NotLive or TileStatus.Offline)
        {
            <div class="tile-msg @(Tile.Status == TileStatus.Error ? "err" : "")">
                <div class="msg-text">@Message</div>
                <a class="msg-link" href="@Tile.OpenUrl" target="_blank" rel="noopener">@L.F("tile.open", Tile.OpenSiteName)</a>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Tile Tile { get; set; } = default!;

    ElementReference _host;
    DotNetObjectReference<TileFrame>? _self;
    string? _lastKey;

    bool IsAudio => State.ActiveAudioId == Tile.Id;
    bool Zoomed => State.ZoomedId == Tile.Id;
    bool Control => State.IsControl(Tile);
    bool Dim => Tile.Status is TileStatus.NotLive or TileStatus.Offline;
    string Style => $"grid-area:{Tile.GridArea};";
    string Message => Tile.Status switch
    {
        TileStatus.NotLive => L["tile.notlive"],
        TileStatus.Offline => L["tile.offline"],
        _ => Tile.StatusMessage is { } k ? L[k] : L["tile.cantplay"]
    };

    // 只有影響外觀（外層 style、標題列、狀態）的值變了才重繪；播放器容器本身永遠不被重建。
    protected override bool ShouldRender()
    {
        var key = string.Join('|', Tile.GridArea, Tile.DisplayName, Tile.Viewers, Tile.Status, Tile.StatusMessage,
            IsAudio, Control, Zoomed, Tile.Id, L.Lang);
        if (key == _lastKey) return false;
        _lastKey = key;
        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        await Player.CreateAsync(Tile, _host, _self);
    }

    [JSInvokable]
    public async Task OnPlayerEvent(string kind, string data)
    {
        switch (kind)
        {
            case "ready":
            case "playing":
            case "online":
                if (Tile.Status != TileStatus.Error || kind != "ready") State.SetStatus(Tile.Id, TileStatus.Playing);
                break;
            case "offline":
                State.SetStatus(Tile.Id, TileStatus.Offline);
                break;
            case "error":
                if (Tile.Source == TileSource.YouTubeChannel && data is "100" or "101" or "150" or "2")
                    State.SetStatus(Tile.Id, TileStatus.NotLive);
                else
                    State.SetStatus(Tile.Id, TileStatus.Error, data switch   // StatusMessage 存的是在地化鍵值
                    {
                        "2" => "err.2",
                        "5" => "err.5",
                        "100" => "err.100",
                        "101" or "150" => "err.101",
                        "script" => "err.script",
                        _ => "tile.cantplay"
                    });
                break;
            case "muteMismatch":
                await State.OnActualMuteChangedAsync(Tile.Id, data == "true");
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await Player.DestroyAsync(Tile.Id);
        _self?.Dispose();
    }
}
